{
  "hosting": {
    "public": "build",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/category/analytics",
        "destination": "/category/analysis-tools",
        "type": 301
      },
      {
        "source": "/category/analytics/",
        "destination": "/category/analysis-tools",
        "type": 301
      },
      {
        "source": "/category/infrastructure",
        "destination": "/category/infrastructure-&-apis",
        "type": 301
      },
      {
        "source": "/category/infrastructure/",
        "destination": "/category/infrastructure-&-apis",
        "type": 301
      }
    ]
  }
}
